# Copy this file to .env.local and fill in the two values from your Supabase project
# (Project Settings > API). With them the site reads and saves the shared family tree;
# without them it runs in trial mode from the files in content/.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-publishable-or-anon-key

# Optional: visitor statistics with Google Analytics. Paste the measurement ID of the site's
# web data stream (Google Analytics > Admin > Data streams > your stream). Leave it out and
# Google Analytics is not added to the site.
# VITE_GA_ID=G-XXXXXXXXXX
